# ---------------------------------------------------------------------------
# QueryMind AI — PRODUCTION environment template.
#
#   cp .env.production.example .env.production   # then edit and keep it private
#
# .env.production is git-ignored. Never commit real values and never build
# them into an image (.dockerignore excludes every .env* file).
# Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------

# --- Public endpoint (required) --------------------------------------------
# DOMAIN is the hostname Caddy serves and obtains a Let's Encrypt certificate
# for. It must resolve to this host. For a local smoke test only, use
# DOMAIN=localhost (Caddy then issues a self-signed certificate).
DOMAIN=querymind.example.com
# Contact address for the ACME account (expiry notices).
ACME_EMAIL=admin@example.com

# --- Application secrets (required) ---------------------------------------
# Production startup refuses to run with the placeholder values below or with
# an insecure frontend origin / cookie configuration.
APP_SECRET_KEY=replace-with-a-random-secret
ENCRYPTION_KEY=

# --- Metadata database (required) -----------------------------------------
# Consumed by the postgres service and interpolated into DATABASE_URL.
POSTGRES_USER=querymind_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=querymind
# Optional: override the internal Docker subnet if 172.28.0.0/24 is taken.
# COMPOSE_SUBNET=172.28.0.0/24

# --- Public origin used for CORS and cookie policy (required) --------------
# Must be exactly the browser-visible origin (scheme + host), for example
# https://querymind.example.com . Comma-separate additional explicit origins.
FRONTEND_ORIGIN=https://querymind.example.com

# --- AI provider (real inference; no mock provider exists) ------------------
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
# CPU inference of a 7B model is slow: keep this generous.
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2
# Short-lived cache for GET /api/health/ai so repeated probes do not hammer the
# model server.
AI_HEALTH_CACHE_SECONDS=15

# --- Query limits ----------------------------------------------------------
QUERY_TIMEOUT_SECONDS=15
MAX_QUERY_ROWS=1000
MAX_RESULT_BYTES=5000000

# --- Network policy for user-supplied database hosts -----------------------
# The metadata database above is NOT subject to this policy; it applies to the
# analytical databases users connect in the UI.
ALLOW_PRIVATE_DB_HOSTS=false
DB_DESTINATION_ALLOWLIST=

# --- Rate limits (per minute, per client IP) -------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_MINUTE=30

# --- Cookie policy ---------------------------------------------------------
# Cookies are automatically Secure when APP_ENV=production. Keep SameSite=lax
# for the same-origin deployment; COOKIE_SAMESITE=none requires Secure and is
# only needed for a deliberately cross-site frontend.
COOKIE_SAMESITE=lax

# --- Database connection pooling ------------------------------------------
# Lower these when the metadata database is a managed service with a low
# connection cap (the pool is per uvicorn process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
