# ---------------------------------------------------------------------------
# QueryMind AI — environment configuration (copy to .env and edit)
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------

APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret

# --- Application metadata database (users, connections, history, ...) ---
# docker-compose maps the app Postgres to host port 5434 (5432 was already taken).
DATABASE_URL=postgresql+psycopg://app_user:app_password_change_me@localhost:5434/querymind

# --- AI provider (Ollama is the default) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=60

# --- NVIDIA NIM (used only when AI_PROVIDER=nvidia) ------------------------
# Hosted OpenAI-compatible endpoint. The model ID is always read from
# NVIDIA_MODEL -- no model ID is assumed. Get a key and pick a model ID at
# https://build.nvidia.com (the full list is served by GET /v1/models).
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=

# --- Credential encryption (REQUIRED to save database connections) ---
# 32-byte Fernet key. The app refuses to store connections without it.
ENCRYPTION_KEY=

# --- Frontend origin for CORS / cookies ---
# Comma-separate multiple origins, e.g. https://app.example.com,https://admin.example.com
# Production requires explicit https:// origins (no "*" and no localhost) and
# Secure cookies; the app refuses to start otherwise.
FRONTEND_ORIGIN=http://localhost:5173

# --- Cookie hardening ---
# Leave COOKIE_SECURE unset: cookies become Secure automatically when APP_ENV=production.
# Setting COOKIE_SECURE=false in production is rejected at startup.
# COOKIE_SECURE=
COOKIE_SAMESITE=lax

# --- Query limits ---
QUERY_TIMEOUT_SECONDS=15
MAX_QUERY_ROWS=1000
MAX_RESULT_BYTES=5000000

# --- Network policy for user-supplied database hosts ---
# development: loopback + private network hosts allowed (local Docker Postgres).
# production:  set ALLOW_PRIVATE_DB_HOSTS=false so only public destinations resolve,
#              and optionally pin an explicit allowlist (comma separated hostnames/IPs).
ALLOW_PRIVATE_DB_HOSTS=true
DB_DESTINATION_ALLOWLIST=

# --- Rate limiting (requests per window) ---
# In-process only; see docs/rate-limiting.md before scaling to multiple instances.
AUTH_RATE_LIMIT_PER_MINUTE=10
QUERY_RATE_LIMIT_PER_MINUTE=30

# --- Reverse proxy trust --------------------------------------------------
# Only these peers (IPs/CIDRs) may set X-Forwarded-For; the rate limiter
# ignores the header entirely when this is empty. Development has no proxy.
TRUSTED_PROXY_IPS=

# --- Metadata database pool (per uvicorn process) -------------------------
# Lower these for a managed PostgreSQL instance with a low connection cap.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Require TLS for the metadata database in production. Set to false only when
# the database is reachable exclusively on a private network.
REQUIRE_DB_TLS=true

# --- Health / logging -----------------------------------------------------
# Cache window for GET /api/health/ai so probes do not hammer the model server.
AI_HEALTH_CACHE_SECONDS=15
LOG_LEVEL=INFO
